{
  "name": "@dataweave/native",
  "version": "0.0.1",
  "description": "Node.js bindings for the DataWeave native library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node-gyp rebuild && tsc",
    "build:addon": "node-gyp rebuild",
    "build:ts": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:tck": "vitest run --project tck",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --project unit --coverage",
    "pack": "npm pack"
  },
  "files": [
    "dist/",
    "native/",
    "build/Release/dwlib_addon.node",
    "src/addon.c",
    "binding.gyp"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "gypfile": true,
  "devDependencies": {
    "@types/node": "^20",
    "@vitest/coverage-v8": "^3.0",
    "fast-xml-parser": "^5.10.1",
    "node-gyp": "^13",
    "typescript": "^5.5",
    "vitest": "^3.0"
  }
}
